{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tsuikaii-translations",
  "main": "src/index.js",
  "compatibility_date": "2026-10-03",
  "vars": {
    "SITE_ORIGIN": "https://tsuikaii.com",
    "ALLOWED_ORIGINS": "https://tsuikaii.com,https://5cm.tsuikaii.com",
    "FILM_ORIGIN": "https://5cm.tsuikaii.com",
    "LLM_BASE_URL": "https://api.deepseek.com",
    "LLM_MODEL": "deepseek-flash",
    "MAX_DAILY_CALLS": "50",
    "MAX_DAILY_CHARACTERS": "200000",
    "MAX_REQUESTS_PER_MINUTE": "20"
  },
  "durable_objects": {
    "bindings": [{ "name": "TRANSLATIONS", "class_name": "TranslationStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TranslationStore"] }]
}
